--[[
================================================================================
  BUNNY'S GAMBIT -- an aggressive, sacrifice-driven chess engine
  "Sacrifice the piece. Trap the king. End the game."
================================================================================
  Ground-up rebuild. The identity lives in three places that are genuinely
  new, not re-themed:

    * TACTICAL PATTERN SCANNER  -- every evaluation pass looks for forks,
      pins/skewers, hanging pieces and king-zone collapse, not just material
      and piece-square tables.

    * SACRIFICE COMPENSATION    -- a material-losing move is not simply
      punished by its SEE score. If it drives toward the enemy king (check,
      king-zone entry, line-opening) it is flagged as a sacrifice candidate,
      exempted from SEE pruning, and handed to full-width search so the
      engine actually calculates whether the attack works -- it is never
      accepted on vibes alone.

    * KING-HUNT SEARCH POLICY   -- forcing moves (checks, sac candidates,
      discovered-attack setups) get search EXTENSIONS instead of the late-
      move reductions quiet moves receive, and critical nodes (in check, or
      a king's safety has collapsed) get a widened move budget so the engine
      looks at many more candidate defences before trusting a cutoff --
      approximating the ~25-reply analysis at sharp decision points.

  Everything else (0x88 board, legal-move generation, Zobrist hashing, the
  transposition table, FEN parsing, SEE, time control) is conventional
  chess-programming plumbing. It is written fresh for this engine, but it
  is deliberately NOT reinvented for its own sake -- correctness there
  matters more than novelty.
================================================================================
]]

local G = _G.__BUNNYS_GAMBIT or {}
_G.__BUNNYS_GAMBIT = G

-- ---------------------------------------------------------------------------
-- Runtime shims (Roblox Luau globals this module depends on)
-- ---------------------------------------------------------------------------
local bit = bit32
local band, bor, bxor, rshift, lshift = bit.band, bit.bor, bit.bxor, bit.rshift, bit.lshift
local floor, abs, mmin, mmax, mlog = math.floor, math.abs, math.min, math.max, math.log
local clock = os.clock
local yield = (task and task.wait) or function() end

------------------------------------------------------------------------------
-- Core constants
------------------------------------------------------------------------------
local INF, MATE, MAX_PLY = 1000000000, 100000, 100
local WHITE, BLACK = 1, -1
local PAWN, KNIGHT, BISHOP, ROOK, QUEEN, KING = 1, 2, 3, 4, 5, 6

local VAL      = {100, 320, 330, 500, 900, 20000}   -- used for SEE / MVV-LVA / threat weighing
local PHASE_W  = {0, 1, 1, 2, 4, 0}                 -- game-phase weight per piece type

local KNIGHT_D = {33, 31, 18, 14, -14, -18, -31, -33}
local BISHOP_D = {15, 17, -15, -17}
local ROOK_D   = {1, -1, 16, -16}
local KING_D   = {1, -1, 16, -16, 15, 17, -15, -17}
local PROMOS   = {QUEEN, ROOK, BISHOP, KNIGHT}

local FLAG_CAPTURE, FLAG_EP, FLAG_CASTLE, FLAG_DOUBLE = 1, 2, 4, 8

local START_FEN = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"

-- 0x88 validity: square s is on-board when (s & 0x88) == 0. Offset by 64 so
-- deltas that stray negative still index a Lua array cleanly.
local ON = {}
for i = 0, 255 do
    local s = i - 64
    ON[i] = (s >= 0 and s < 128 and band(s, 8) == 0)
end

-- Castling-rights-clearing mask per origin/destination square (rook moves
-- or captures on a corner, or the king moving, strip the matching bit).
local CASTLE_CLEAR = {}
for i = 0, 127 do CASTLE_CLEAR[i] = 15 end
CASTLE_CLEAR[0] = 13; CASTLE_CLEAR[7] = 14; CASTLE_CLEAR[4] = 12
CASTLE_CLEAR[112] = 7; CASTLE_CLEAR[119] = 11; CASTLE_CLEAR[116] = 3

------------------------------------------------------------------------------
-- Move encoding: 21-bit int = from(7) | to(7) | promo(3) | flags(4)
------------------------------------------------------------------------------
local function encMove(from, to, promo, flags)
    return from + to * 128 + promo * 16384 + flags * 131072
end
local function mvFrom(m)  return band(m, 127) end
local function mvTo(m)    return band(rshift(m, 7), 127) end
local function mvPromo(m) return band(rshift(m, 14), 7) end
local function mvFlags(m) return band(rshift(m, 17), 15) end

local function squareName(s)
    return string.char(97 + band(s, 15)) .. tostring(rshift(s, 4) + 1)
end

local PROMO_LETTER = {[KNIGHT] = "n", [BISHOP] = "b", [ROOK] = "r", [QUEEN] = "q"}
local function moveAlgebraic(m)
    return squareName(mvFrom(m)) .. squareName(mvTo(m)) .. (PROMO_LETTER[mvPromo(m)] or "")
end

------------------------------------------------------------------------------
-- Zobrist hashing (two 32-bit lanes combined for an effectively 64-bit key)
------------------------------------------------------------------------------
G.Seed = G.Seed or 0x42B00117   -- Bunny's own seed
G.Z1, G.Z2 = G.Z1 or {}, G.Z2 or {}
G.ZCastle1, G.ZCastle2 = G.ZCastle1 or {}, G.ZCastle2 or {}
G.ZEp1, G.ZEp2 = G.ZEp1 or {}, G.ZEp2 or {}
G.SearchId = G.SearchId or 0
G.History = G.History or {}

local function rand32()
    local x = G.Seed
    x = bxor(x, lshift(x, 13))
    x = bxor(x, rshift(x, 17))
    x = bxor(x, lshift(x, 5))
    G.Seed = x
    return x
end

if not G.ZInitialized then
    for p = 1, 12 do
        G.Z1[p], G.Z2[p] = {}, {}
        for s = 0, 127 do
            G.Z1[p][s + 1] = rand32()
            G.Z2[p][s + 1] = rand32()
        end
    end
    for i = 0, 15 do G.ZCastle1[i + 1] = rand32(); G.ZCastle2[i + 1] = rand32() end
    for i = 0, 7 do G.ZEp1[i + 1] = rand32(); G.ZEp2[i + 1] = rand32() end
    G.ZSide1 = rand32()
    G.ZSide2 = rand32()
    G.ZInitialized = true
end

-- Signed-piece lookup tables (piece in -6..6, skip 0) pointing at the Z1/Z2
-- rows above, so hashing code can write ZP1[piece][sq+1] directly.
local ZP1, ZP2 = {}, {}
for p = -6, 6 do
    if p ~= 0 then
        local i = p > 0 and p or 6 - p
        ZP1[p + 7] = G.Z1[i]
        ZP2[p + 7] = G.Z2[i]
    end
end
local ZE1, ZE2, ZC1, ZC2 = G.ZEp1, G.ZEp2, G.ZCastle1, G.ZCastle2
local ZS1, ZS2 = G.ZSide1, G.ZSide2

------------------------------------------------------------------------------
