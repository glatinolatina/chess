    -50, -30, -30, -30, -30, -30, -30, -50 }
do -- endgame pawns: push them -- a Bunny's Gambit passed pawn is a weapon
    local adv = {0, 0, 10, 24, 42, 68, 105, 0}
    local t = {}
    for i = 1, 64 do
        local row = floor((i - 1) / 8) -- 0 = rank 8
        t[i] = adv[8 - row]
    end
    PST_EG[PAWN] = t
end

-- Combined, tapered, colour-signed tables indexed [piece+7][0x88 square]:
-- MGT/EGT already fold in material value, so mg/eg deltas during make/unmake
-- are a single table lookup + subtraction.
local MGT, EGT = {}, {}
for i = 1, 13 do MGT[i], EGT[i] = {}, {} end
for t = 1, 6 do
    for s = 0, 127 do
        if band(s, 8) == 0 then
            local r, f = rshift(s, 4), band(s, 15)
            local iw = (7 - r) * 8 + f + 1
            local ib = r * 8 + f + 1
            MGT[t + 7][s] = MAT_MG[t] + PST_MG[t][iw]
            EGT[t + 7][s] = MAT_EG[t] + PST_EG[t][iw]
            MGT[7 - t][s] = -(MAT_MG[t] + PST_MG[t][ib])
            EGT[7 - t][s] = -(MAT_EG[t] + PST_EG[t][ib])
        end
    end
end

------------------------------------------------------------------------------
-- Attack detection
------------------------------------------------------------------------------
local function isAttacked(E, s, by)
    local B = E.board
    if by == WHITE then
        local a = s - 15
        if ON[a + 64] and B[a] == PAWN then return true end
        a = s - 17
        if ON[a + 64] and B[a] == PAWN then return true end
    else
        local a = s + 15
        if ON[a + 64] and B[a] == -PAWN then return true end
        a = s + 17
        if ON[a + 64] and B[a] == -PAWN then return true end
    end
    local kn = by * KNIGHT
    for i = 1, 8 do
        local t = s + KNIGHT_D[i]
        if ON[t + 64] and B[t] == kn then return true end
    end
    local bi, qu, ro, ki = by * BISHOP, by * QUEEN, by * ROOK, by * KING
    for i = 1, 4 do
        local d = BISHOP_D[i]
        local t = s + d
        while ON[t + 64] do
            local p = B[t]
            if p ~= 0 then
                if p == bi or p == qu then return true end
                break
            end
            t = t + d
        end
    end
    for i = 1, 4 do
        local d = ROOK_D[i]
        local t = s + d
        while ON[t + 64] do
            local p = B[t]
            if p ~= 0 then
                if p == ro or p == qu then return true end
                break
            end
            t = t + d
        end
    end
    for i = 1, 8 do
        local t = s + KING_D[i]
        if ON[t + 64] and B[t] == ki then return true end
    end
    return false
end

local function inCheck(E, side)
    local k = side == WHITE and E.kingW or E.kingB
    return isAttacked(E, k, -side)
end

-- Returns the attacking square nearest to `s` for `by`, or -1. Used by SEE
-- and by the tactical scanner (cheapest-attacker lookups).
local function nearestAttacker(B, s, by)
    if by == WHITE then
        local a = s - 15
        if ON[a + 64] and B[a] == PAWN then return a end
        a = s - 17
        if ON[a + 64] and B[a] == PAWN then return a end
    else
        local a = s + 15
        if ON[a + 64] and B[a] == -PAWN then return a end
        a = s + 17
        if ON[a + 64] and B[a] == -PAWN then return a end
    end
    local kn = by * KNIGHT
    for i = 1, 8 do
        local t = s + KNIGHT_D[i]
        if ON[t + 64] and B[t] == kn then return t end
    end
    local bi = by * BISHOP
    for i = 1, 4 do
        local d = BISHOP_D[i]
        local t = s + d
        while ON[t + 64] do
            local p = B[t]
            if p ~= 0 then
                if p == bi then return t end
                break
            end
            t = t + d
        end
    end
    local ro = by * ROOK
    for i = 1, 4 do
        local d = ROOK_D[i]
        local t = s + d
        while ON[t + 64] do
            local p = B[t]
            if p ~= 0 then
                if p == ro then return t end
                break
            end
            t = t + d
        end
    end
    local qu = by * QUEEN
    for i = 1, 8 do
        local d = KING_D[i]
        local t = s + d
        while ON[t + 64] do
            local p = B[t]
            if p ~= 0 then
                if p == qu then return t end
                break
            end
            t = t + d
        end
    end
    local ki = by * KING
    for i = 1, 8 do
        local t = s + KING_D[i]
        if ON[t + 64] and B[t] == ki then return t end
    end
    return -1
end

------------------------------------------------------------------------------
-- Pseudo-legal move generation
------------------------------------------------------------------------------
local function generate(E, capsOnly)
    local B = E.board
    local moves, n = {}, 0
    local side = E.side
    local enemy = -side
    local ep = E.ep
    local step = side * 16
    local startRank = side == WHITE and 1 or 6
    local promoRank = side == WHITE and 7 or 0

    for r = 0, 7 do
        local base = r * 16
        for f = 0, 7 do
            local s = base + f
            local p = B[s]
            if p * side > 0 then
                local t = p > 0 and p or -p
                if t == PAWN then
                    local one = s + step
                    if B[one] == 0 then
                        if rshift(one, 4) == promoRank then
                            if capsOnly then
                                n = n + 1; moves[n] = encMove(s, one, QUEEN, 0)
                            else
                                for i = 1, 4 do n = n + 1; moves[n] = encMove(s, one, PROMOS[i], 0) end
                            end
                        elseif not capsOnly then
                            n = n + 1; moves[n] = encMove(s, one, 0, 0)
                            if r == startRank then
                                local two = one + step
                                if B[two] == 0 then n = n + 1; moves[n] = encMove(s, two, 0, FLAG_DOUBLE) end
                            end
                        end
                    end
                    for k = -1, 1, 2 do
                        local c = one + k
                        if ON[c + 64] then
                            local q = B[c]
                            if q * side < 0 then
                                if rshift(c, 4) == promoRank then
                                    if capsOnly then
                                        n = n + 1; moves[n] = encMove(s, c, QUEEN, FLAG_CAPTURE)
                                    else
                                        for i = 1, 4 do n = n + 1; moves[n] = encMove(s, c, PROMOS[i], FLAG_CAPTURE) end
                                    end
                                else
                                    n = n + 1; moves[n] = encMove(s, c, 0, FLAG_CAPTURE)
                                end
                            elseif q == 0 and c == ep then
                                n = n + 1; moves[n] = encMove(s, c, 0, FLAG_CAPTURE + FLAG_EP)
                            end
                        end
                    end
                elseif t == KNIGHT then
                    for i = 1, 8 do
                        local to = s + KNIGHT_D[i]
                        if ON[to + 64] then
                            local q = B[to]
                            if q == 0 then
                                if not capsOnly then n = n + 1; moves[n] = encMove(s, to, 0, 0) end
                            elseif q * side < 0 then
                                n = n + 1; moves[n] = encMove(s, to, 0, FLAG_CAPTURE)
                            end
                        end
                    end
                elseif t == KING then
                    for i = 1, 8 do
                        local to = s + KING_D[i]
                        if ON[to + 64] then
                            local q = B[to]
                            if q == 0 then
                                if not capsOnly then n = n + 1; moves[n] = encMove(s, to, 0, 0) end
                            elseif q * side < 0 then
                                n = n + 1; moves[n] = encMove(s, to, 0, FLAG_CAPTURE)
                            end
                        end
                    end
                    local cr = E.castle
                    if not capsOnly and cr ~= 0 then
                        if side == WHITE and s == 4 then
                            if band(cr, 1) ~= 0 and B[5] == 0 and B[6] == 0 and B[7] == ROOK
                                and not isAttacked(E, 4, enemy) and not isAttacked(E, 5, enemy) and not isAttacked(E, 6, enemy) then
                                n = n + 1; moves[n] = encMove(4, 6, 0, FLAG_CASTLE)
                            end
                            if band(cr, 2) ~= 0 and B[3] == 0 and B[2] == 0 and B[1] == 0 and B[0] == ROOK
                                and not isAttacked(E, 4, enemy) and not isAttacked(E, 3, enemy) and not isAttacked(E, 2, enemy) then
                                n = n + 1; moves[n] = encMove(4, 2, 0, FLAG_CASTLE)
                            end
                        elseif side == BLACK and s == 116 then
                            if band(cr, 4) ~= 0 and B[117] == 0 and B[118] == 0 and B[119] == -ROOK
                                and not isAttacked(E, 116, enemy) and not isAttacked(E, 117, enemy) and not isAttacked(E, 118, enemy) then
                                n = n + 1; moves[n] = encMove(116, 118, 0, FLAG_CASTLE)
                            end
                            if band(cr, 8) ~= 0 and B[115] == 0 and B[114] == 0 and B[113] == 0 and B[112] == -ROOK
                                and not isAttacked(E, 116, enemy) and not isAttacked(E, 115, enemy) and not isAttacked(E, 114, enemy) then
                                n = n + 1; moves[n] = encMove(116, 114, 0, FLAG_CASTLE)
                            end
                        end
                    end
                else
                    local deltas = (t == BISHOP) and BISHOP_D or (t == ROOK) and ROOK_D or KING_D
                    local stop = (t == QUEEN) and 8 or 4
                    for i = 1, stop do
                        local d = deltas[i]
                        local to = s + d
                        while ON[to + 64] do
                            local q = B[to]
                            if q == 0 then
                                if not capsOnly then n = n + 1; moves[n] = encMove(s, to, 0, 0) end
                            else
                                if q * side < 0 then n = n + 1; moves[n] = encMove(s, to, 0, FLAG_CAPTURE) end
                                break
                            end
                            to = to + d
                        end
                    end
                end
            end
        end
    end
    return moves
end

------------------------------------------------------------------------------
-- Make / unmake, with incrementally maintained hash, tapered mg/eg score,
-- phase and non-pawn material (so evaluate() never has to rescan the board
-- just to find out "how far into the game are we").
------------------------------------------------------------------------------
local function restore(E, S)
    local B = E.board
    local rf = S.rookFrom
    if rf then
        B[rf] = B[S.rookTo]
        B[S.rookTo] = 0
    end
    B[S.to] = 0
    B[S.capSq] = S.captured
    B[S.from] = S.piece
    E.castle = S.castle
    E.ep = S.ep
    E.half = S.half
    E.h1 = S.h1
    E.h2 = S.h2
    E.mg = S.mg
    E.eg = S.eg
    E.phase = S.phase
    E.npmW = S.npmW
    E.npmB = S.npmB
    E.kingW = S.kingW
    E.kingB = S.kingB
    E.side = S.side
end

local function makeMove(E, m, ply)
    local B = E.board
    local from = band(m, 127)
    local to = band(rshift(m, 7), 127)
    local promo = band(rshift(m, 14), 7)
    local flags = band(rshift(m, 17), 15)
    local piece = B[from]
    if piece == 0 then return false end
    local mover = E.side
    local capSq = to
    if band(flags, FLAG_EP) ~= 0 then capSq = to - mover * 16 end
    local captured = B[capSq]

    local S = E.stack[ply]
    if not S then S = {}; E.stack[ply] = S end
    S.from, S.to, S.piece, S.captured, S.capSq = from, to, piece, captured, capSq
    S.castle, S.ep, S.half, S.h1, S.h2 = E.castle, E.ep, E.half, E.h1, E.h2
    S.mg, S.eg, S.phase, S.npmW, S.npmB = E.mg, E.eg, E.phase, E.npmW, E.npmB
    S.kingW, S.kingB, S.side = E.kingW, E.kingB, E.side
    S.rookFrom, S.rookTo = nil, nil

    local h1, h2 = E.h1, E.h2
    local ep = E.ep
    if ep >= 0 then
        local fi = band(ep, 15) + 1
        h1 = bxor(h1, ZE1[fi]); h2 = bxor(h2, ZE2[fi])
    end
    local c = E.castle
    h1 = bxor(h1, ZC1[c + 1]); h2 = bxor(h2, ZC2[c + 1])

    local mg, eg = E.mg, E.eg
    local pi = piece + 7
    h1 = bxor(h1, ZP1[pi][from + 1]); h2 = bxor(h2, ZP2[pi][from + 1])
    mg = mg - MGT[pi][from]; eg = eg - EGT[pi][from]

    if captured ~= 0 then
        local ci = captured + 7
        h1 = bxor(h1, ZP1[ci][capSq + 1]); h2 = bxor(h2, ZP2[ci][capSq + 1])
        mg = mg - MGT[ci][capSq]; eg = eg - EGT[ci][capSq]
        local ac = captured > 0 and captured or -captured
        E.phase = E.phase - PHASE_W[ac]
        if ac ~= PAWN then
            if captured > 0 then E.npmW = E.npmW - VAL[ac] else E.npmB = E.npmB - VAL[ac] end
        end
        B[capSq] = 0
    end
    B[from] = 0

    local placed = piece
    if promo ~= 0 then
        placed = mover * promo
        E.phase = E.phase + PHASE_W[promo]
        if mover == WHITE then E.npmW = E.npmW + VAL[promo] else E.npmB = E.npmB + VAL[promo] end
    end
    B[to] = placed
    local pli = placed + 7
    h1 = bxor(h1, ZP1[pli][to + 1]); h2 = bxor(h2, ZP2[pli][to + 1])
    mg = mg + MGT[pli][to]; eg = eg + EGT[pli][to]

    if piece == KING then E.kingW = to elseif piece == -KING then E.kingB = to end

    if band(flags, FLAG_CASTLE) ~= 0 then
        local rf, rt
        if to == 6 then rf, rt = 7, 5
        elseif to == 2 then rf, rt = 0, 3
        elseif to == 118 then rf, rt = 119, 117
        else rf, rt = 112, 115 end
        local rook = B[rf]
        B[rf] = 0
        B[rt] = rook
        S.rookFrom, S.rookTo = rf, rt
        local ri = rook + 7
        h1 = bxor(h1, ZP1[ri][rf + 1]); h1 = bxor(h1, ZP1[ri][rt + 1])
        h2 = bxor(h2, ZP2[ri][rf + 1]); h2 = bxor(h2, ZP2[ri][rt + 1])
        mg = mg - MGT[ri][rf] + MGT[ri][rt]
        eg = eg - EGT[ri][rf] + EGT[ri][rt]
    end

    c = band(c, CASTLE_CLEAR[from], CASTLE_CLEAR[to])
    E.castle = c
    h1 = bxor(h1, ZC1[c + 1]); h2 = bxor(h2, ZC2[c + 1])

    if band(flags, FLAG_DOUBLE) ~= 0 then
        ep = rshift(from + to, 1)
        local fi = band(ep, 15) + 1
        h1 = bxor(h1, ZE1[fi]); h2 = bxor(h2, ZE2[fi])
    else
        ep = -1
    end
    E.ep = ep
    h1 = bxor(h1, ZS1); h2 = bxor(h2, ZS2)

    if piece == PAWN or piece == -PAWN or captured ~= 0 then E.half = 0 else E.half = E.half + 1 end
    E.mg, E.eg = mg, eg
    E.h1, E.h2 = h1, h2
    E.side = -mover

    local ks = (mover == WHITE) and E.kingW or E.kingB
    if isAttacked(E, ks, -mover) then
        restore(E, S)
        return false
    end
    local n = E.repN + 1
    E.repN = n
    E.rep1[n], E.rep2[n] = h1, h2
    return true
end

local function unmakeMove(E, m, ply)
    restore(E, E.stack[ply])
    E.repN = E.repN - 1
end

------------------------------------------------------------------------------
-- Static Exchange Evaluation -- "if a full exchange happens on this square,
-- who comes out ahead and by how much". Used for capture ordering, qsearch
-- pruning, and as one input to the sacrifice-compensation judgement below.
------------------------------------------------------------------------------
local seeGain, seeSq, seeOld = {}, {}, {}
local function see(E, m)
    local B = E.board
    local from, to = band(m, 127), band(rshift(m, 7), 127)
    local flags, promo = band(rshift(m, 17), 15), band(rshift(m, 14), 7)
    local piece = B[from]
    local side = piece > 0 and WHITE or BLACK
    local target = B[to]
    local g0
    if band(flags, FLAG_EP) ~= 0 then g0 = VAL[PAWN]
    elseif target ~= 0 then g0 = VAL[abs(target)]
    else g0 = 0 end
    local attVal = VAL[abs(piece)]
    if promo ~= 0 then g0 = g0 + VAL[promo] - VAL[PAWN]; attVal = VAL[promo] end
    seeGain[1] = g0
    local oldFrom, oldTo = B[from], B[to]
    B[from] = 0
    B[to] = piece
    local d, n = 1, 0
    side = -side
    while true do
        local sq = nearestAttacker(B, to, side)
        if sq < 0 then break end
        d = d + 1
        seeGain[d] = attVal - seeGain[d - 1]
        if mmax(-seeGain[d - 1], seeGain[d]) < 0 then
            d = d - 1
            break
        end
        local p = B[sq]
        attVal = VAL[abs(p)]
        n = n + 1
        seeSq[n], seeOld[n] = sq, p
        B[sq] = 0
        B[to] = p
        side = -side
    end
    for i = n, 1, -1 do B[seeSq[i]] = seeOld[i] end
    B[from] = oldFrom
    B[to] = oldTo
    while d > 1 do
        seeGain[d - 1] = -mmax(-seeGain[d - 1], seeGain[d])
        d = d - 1
    end
    return seeGain[1]
end

------------------------------------------------------------------------------
-- TACTICAL PATTERN SCANNER
--
-- This is the heart of the rebuild. Instead of trusting material count and
-- piece-square tables alone, every evaluation walks each piece's line of
-- attack and asks three questions:
--
--   1. FORKS      -- does this piece attack two or more enemy targets at
--                    once, at least one of them more valuable than itself
--                    or simply undefended?
--   2. PINS/SKEWERS -- does an x-ray along this ray reveal a more valuable
--                    piece (or the king) standing behind the first blocker?
--   3. HANGING PIECES / THREATS -- is an enemy piece attacked by something
--                    cheaper than it, or more times than it is defended?
--
-- The scanner also builds the king-zone pressure numbers used for the
-- king-hunt score, and reports the few numbers the sacrifice-compensation
-- function needs (zone-entry flags per candidate square) without a second
-- board pass.
------------------------------------------------------------------------------
local FORK_UNIT  = {0, 10, 34, 38, 55, 78, 0}   -- per attacked-piece-type fork credit
local PIN_UNIT   = {0, 0, 24, 26, 34, 46, 0}    -- credit for pinning this piece type
local HANG_FRAC  = 0.34                          -- fraction of value credited for a loose piece
local CHECK_MULT = 46                            -- flat credit per discovered/direct check threat found

-- Returns true if `sq` currently has strictly more attackers from `side`
-- than defenders from `-side` have reasonable claim to (cheap heuristic:
-- just compares the *cheapest* attacker to the piece's value, which is
-- enough to flag "this is loose" without a full SEE on every square).
local function pieceIsLoose(E, sq, pieceSide)
    local B = E.board
    local atk = nearestAttacker(B, sq, -pieceSide)
    if atk < 0 then return false end
    local def = nearestAttacker(B, sq, pieceSide)
    local attackerVal = VAL[abs(B[atk])]
    local pieceVal = VAL[abs(B[sq])]
    if def < 0 then return true end          -- attacked and totally undefended
    return attackerVal < pieceVal             -- attacked by something cheaper than it
end

------------------------------------------------------------------------------
-- The identity. One cohesive personality, not a menu of them: aggressive,
-- tactical, and willing to spend material when the attack justifies it.
-- A couple of numeric knobs are still exposed through Engine:Configure for
-- tuning, but there is no "Calm" or "Defensive" preset to fall back into --
-- that would defeat the point of the rebuild.
------------------------------------------------------------------------------
local IDENTITY = {
    Att = 1.30,          -- king-hunt danger weight
    Safe = 0.95,         -- own king shelter weight (still respected, just not paramount)
    Mob = 1.05,          -- mobility weight
    Pwn = 1.05,          -- pawn-structure weight
    Tac = 1.20,          -- fork / pin / skewer credit weight
    Contempt = 18,       -- resist offering/accepting draws
    Center = 9,          -- central quiet-move ordering bonus
    LMR = 0.88,          -- slightly gentler late-move reductions (look wider)
}
G.Identity = IDENTITY

------------------------------------------------------------------------------
-- Evaluation state (rebuilt fresh each evaluate() call; kept as module-level
-- scratch arrays so no table is allocated per node).
------------------------------------------------------------------------------
local PASS_MG = {0, 6, 12, 22, 38, 64, 108, 0}
local PASS_EG = {0, 10, 20, 42, 74, 126, 198, 0}
local THREAT  = {0, 26, 26, 46, 64, 0}     -- pawn-diagonal threat credit by victim type
local ATK_MULT   = {0, 0, 50, 75, 88, 94, 97, 99, 100}
local FLIGHT_MULT = {170, 142, 120, 106, 100, 100, 100, 100, 100}
local TEMPO = 12
local LAZY  = 350

local fileW, fileB, maxRB, minRW = {}, {}, {}, {}
local LW = {{}, {}, {}, {}, {}, {}}
local LB = {{}, {}, {}, {}, {}, {}}
local CW = {0, 0, 0, 0, 0, 0}
local CB = {0, 0, 0, 0, 0, 0}
local pAtkW, pAtkB, zoneW, zoneB = {}, {}, {}, {}
local evalStamp = 0

local function kdist(a, b)
    local dr = abs(rshift(a, 4) - rshift(b, 4))
    local df = abs(band(a, 15) - band(b, 15))
    return dr > df and dr or df
end

-- Number of squares the king at `kingSq` could actually flee to right now:
-- empty-or-capturable AND not covered by the opponent. This is the direct
-- measurement behind "restricted king mobility" / "mating net" scoring.
local function kingFlightSquares(E, kingSq, kingSide)
    local B = E.board
    local enemy = -kingSide
    local n = 0
    for i = 1, 8 do
        local t = kingSq + KING_D[i]
        if ON[t + 64] then
            local q = B[t]
            if q * kingSide <= 0 and not isAttacked(E, t, enemy) then n = n + 1 end
        end
    end
    return n
end

local function hangingTerm(E)
    local score = 0
    for t = 2, 5 do
        for i = 1, CW[t] do
            local s = LW[t][i]
            if pieceIsLoose(E, s, WHITE) then score = score - floor(VAL[t] * HANG_FRAC) end
        end
        for i = 1, CB[t] do
            local s = LB[t][i]
            if pieceIsLoose(E, s, BLACK) then score = score + floor(VAL[t] * HANG_FRAC) end
        end
    end
    return score
end

local function evalSide(E, B, side, L, C, ownFile, enExt, pAtkEn, zoneEn, stamp, ownK, enK, st)
    local mg, eg, aw, an = 0, 0, 0, 0
    local mob, pw, safe, tac = st.Mob, st.Pwn, st.Safe, st.Tac
    local pawn = side * PAWN
    local fwd = side * 16
    local enemyKingFile = band(enK, 15)

    -- pawns: structure, passing, connection, storms toward the enemy king,
    -- and direct diagonal threats (fork-like: one pawn eyeing two pieces
    -- shows up automatically since both diagonals are scored independently)
    for i = 1, C[1] do
        local s = L[1][i]
        local f, r = band(s, 15), rshift(s, 4)
        local fi = f + 2
        local rr = (side == WHITE) and r or 7 - r
        if ownFile[fi - 1] == 0 and ownFile[fi + 1] == 0 then
            mg = mg - 10 * pw; eg = eg - 16 * pw
        end
        local passed
        if side == WHITE then
            passed = enExt[fi - 1] <= r and enExt[fi] <= r and enExt[fi + 1] <= r
        else
            passed = enExt[fi - 1] >= r and enExt[fi] >= r and enExt[fi + 1] >= r
        end
        if passed then
            local bm, be = PASS_MG[rr + 1], PASS_EG[rr + 1]
            local stop = s + fwd
            if (B[stop] or 0) ~= 0 then bm = bm * 0.5; be = be * 0.5 end
            if rr >= 2 then
                be = be + (kdist(enK, stop) * 4 - kdist(ownK, stop) * 2) * rr * 0.5
            end
            mg = mg + bm * pw; eg = eg + be * pw
        end
        if B[s - fwd - 1] == pawn or B[s - fwd + 1] == pawn or B[s - 1] == pawn or B[s + 1] == pawn then
            mg = mg + (3 + rr * 2) * pw
            eg = eg + (5 + rr * 3) * pw
        end
        -- pawn storm: an advanced pawn on or beside the enemy king's file is
        -- a battering ram, not just a pawn -- credit it like one
        if rr >= 3 and abs(f - enemyKingFile) <= 1 then
            mg = mg + (rr - 2) * 9 * tac
        end
        for k = -1, 1, 2 do
            local t = s + fwd + k
            if ON[t + 64] then
                local q = B[t]
                if q * side < 0 then
                    local a = q > 0 and q or -q
                    if a > 1 and a < 6 then mg = mg + THREAT[a]; eg = eg + THREAT[a] end
                end
            end
        end
    end
    for fi = 2, 9 do
        local c = ownFile[fi]
        if c > 1 then
            mg = mg - (c - 1) * 10 * pw
            eg = eg - (c - 1) * 22 * pw
        end
    end

    -- knights: mobility, king-zone pressure, outposts, forks
    for i = 1, C[2] do
        local s = L[2][i]
        local cnt, hit = 0, false
        local forkHits, forkVal = 0, 0
        for k = 1, 8 do
            local t = s + KNIGHT_D[k]
            if ON[t + 64] then
                local q = B[t]
                if q * side <= 0 and pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                if zoneEn[t] == stamp then hit = true end
                if q * side < 0 then
                    forkHits = forkHits + 1
                    forkVal = forkVal + FORK_UNIT[abs(q)]
                end
            end
        end
        mg = mg + (cnt - 4) * 4 * mob
        eg = eg + (cnt - 4) * 4 * mob
        if hit then aw = aw + 20; an = an + 1 end
        if forkHits >= 2 then
            mg = mg + forkVal * tac; eg = eg + forkVal * 0.6 * tac
        end
        if pAtkEn[s] ~= stamp and (B[s - fwd - 1] == pawn or B[s - fwd + 1] == pawn) then
            local rr = (side == WHITE) and rshift(s, 4) or 7 - rshift(s, 4)
            if rr >= 3 then mg = mg + 16; eg = eg + 10 end
        end
    end

    -- bishops: mobility, king-zone pressure, pair bonus, forks, pins/skewers
    for i = 1, C[3] do
        local s = L[3][i]
        local cnt, hit = 0, false
        local forkHits, forkVal = 0, 0
        for k = 1, 4 do
            local d = BISHOP_D[k]
            local t = s + d
            while ON[t + 64] do
                local q = B[t]
                if zoneEn[t] == stamp then hit = true end
                if q == 0 then
                    if pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                else
                    if q * side < 0 then
                        if pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                        forkHits = forkHits + 1
                        forkVal = forkVal + FORK_UNIT[abs(q)]
                        local blockerVal = VAL[abs(q)]
                        local t2 = t + d
                        while ON[t2 + 64] do
                            local q2 = B[t2]
                            if q2 ~= 0 then
                                if q2 * side < 0 then
                                    if abs(q2) == KING then
                                        mg = mg + PIN_UNIT[BISHOP] * 1.6 * tac; eg = eg + PIN_UNIT[BISHOP] * 1.2 * tac
                                    elseif VAL[abs(q2)] > blockerVal then
                                        mg = mg + PIN_UNIT[BISHOP] * tac; eg = eg + PIN_UNIT[BISHOP] * 0.8 * tac
                                    end
                                end
                                break
                            end
                            t2 = t2 + d
                        end
                    end
                    break
                end
                t = t + d
            end
        end
        mg = mg + (cnt - 5) * 5 * mob
        eg = eg + (cnt - 5) * 5 * mob
        if hit then aw = aw + 20; an = an + 1 end
        if forkHits >= 2 then
            mg = mg + forkVal * tac; eg = eg + forkVal * 0.6 * tac
        end
    end
    if C[3] >= 2 then mg = mg + 32; eg = eg + 52 end

    -- rooks: mobility, open/semi-open files, 7th rank, forks, pins/skewers
    for i = 1, C[4] do
        local s = L[4][i]
        local f, r = band(s, 15), rshift(s, 4)
        local cnt, hit = 0, false
        local forkHits, forkVal = 0, 0
        for k = 1, 4 do
            local d = ROOK_D[k]
            local t = s + d
            while ON[t + 64] do
                local q = B[t]
                if zoneEn[t] == stamp then hit = true end
                if q == 0 then
                    if pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                else
                    if q * side < 0 then
                        if pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                        forkHits = forkHits + 1
                        forkVal = forkVal + FORK_UNIT[abs(q)]
                        local blockerVal = VAL[abs(q)]
                        local t2 = t + d
                        while ON[t2 + 64] do
                            local q2 = B[t2]
                            if q2 ~= 0 then
                                if q2 * side < 0 then
                                    if abs(q2) == KING then
                                        mg = mg + PIN_UNIT[ROOK] * 1.6 * tac; eg = eg + PIN_UNIT[ROOK] * 1.2 * tac
                                    elseif VAL[abs(q2)] > blockerVal then
                                        mg = mg + PIN_UNIT[ROOK] * tac; eg = eg + PIN_UNIT[ROOK] * 0.8 * tac
                                    end
                                end
                                break
                            end
                            t2 = t2 + d
                        end
                    end
                    break
                end
                t = t + d
            end
        end
        mg = mg + (cnt - 5) * 2 * mob
        eg = eg + (cnt - 5) * 4 * mob
        if hit then aw = aw + 40; an = an + 1 end
        if forkHits >= 2 then
            mg = mg + forkVal * tac; eg = eg + forkVal * 0.6 * tac
        end
        if ownFile[f + 2] == 0 then
            if enExt == maxRB then
                if maxRB[f + 2] < 0 then mg = mg + 24; eg = eg + 14 else mg = mg + 11; eg = eg + 8 end
            else
                if minRW[f + 2] > 7 then mg = mg + 24; eg = eg + 14 else mg = mg + 11; eg = eg + 8 end
            end
        end
        local rr = (side == WHITE) and r or 7 - r
        if rr == 6 then mg = mg + 10; eg = eg + 22 end
    end

    -- queens: mobility, king-zone pressure, forks, pins/skewers (8 rays)
    for i = 1, C[5] do
        local s = L[5][i]
        local cnt, hit = 0, false
        local forkHits, forkVal = 0, 0
        for k = 1, 8 do
            local d = KING_D[k]
            local t = s + d
            while ON[t + 64] do
                local q = B[t]
                if zoneEn[t] == stamp then hit = true end
                if q == 0 then
                    if pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                else
                    if q * side < 0 then
                        if pAtkEn[t] ~= stamp then cnt = cnt + 1 end
                        forkHits = forkHits + 1
                        forkVal = forkVal + FORK_UNIT[abs(q)]
                        local blockerVal = VAL[abs(q)]
                        local t2 = t + d
                        while ON[t2 + 64] do
                            local q2 = B[t2]
                            if q2 ~= 0 then
                                if q2 * side < 0 then
                                    if abs(q2) == KING then
                                        mg = mg + PIN_UNIT[QUEEN] * 1.6 * tac; eg = eg + PIN_UNIT[QUEEN] * 1.2 * tac
                                    elseif VAL[abs(q2)] > blockerVal then
                                        mg = mg + PIN_UNIT[QUEEN] * tac; eg = eg + PIN_UNIT[QUEEN] * 0.8 * tac
                                    end
                                end
                                break
                            end
                            t2 = t2 + d
                        end
                    end
                    break
                end
                t = t + d
            end
        end
        mg = mg + (cnt - 10) * 1 * mob
        eg = eg + (cnt - 10) * 2 * mob
        if hit then aw = aw + 80; an = an + 1 end
        if forkHits >= 2 then
            mg = mg + forkVal * tac * 0.8; eg = eg + forkVal * 0.5 * tac
        end
    end

    -- shelter in front of our own king -- the engine attacks relentlessly,
    -- but a king that gets itself mated has thrown the whole game away
    local kf = band(ownK, 15)
    local sh = 0
    for df = -1, 1 do
        local f = kf + df
        if f >= 0 and f <= 7 then
            local sq1 = ownK + fwd + df
            if B[sq1] == pawn then
                sh = sh + 10
            elseif B[sq1 + fwd] == pawn then
                sh = sh + 5
            else
                sh = sh - 12
                if ownFile[f + 2] == 0 then sh = sh - 10 end
            end
        end
    end
    mg = mg + sh * safe
    return mg, eg, aw, an
end

local function dangerOf(aw, an, enemyQueens, att, flight)
    local fm = FLIGHT_MULT[mmin(flight, 8) + 1] / 100
    if an < 2 then
        if an == 1 and flight <= 1 then
            return aw * 0.55 * att * fm
        end
        return 0
    end
    local d = aw * ATK_MULT[mmin(an, 8) + 1] / 100
    if enemyQueens == 0 then d = d * 0.55 end
    return d * att * fm
end

------------------------------------------------------------------------------
-- Full evaluation: material + PST (already incremental in E.mg/E.eg) +
-- mobility/structure (evalSide) + tactical scan (folded into evalSide) +
-- hanging-piece scan + king-hunt danger (now mobility-aware) + a small
-- initiative term that nudges the engine away from simplifying away a real
-- attack when the alternative is equally sound.
------------------------------------------------------------------------------
local function evaluate(E)
    local B = E.board
    evalStamp = evalStamp + 1
    local stamp = evalStamp
    for i = 1, 10 do
        fileW[i], fileB[i] = 0, 0
        maxRB[i], minRW[i] = -1, 8
    end
    for t = 1, 6 do CW[t] = 0; CB[t] = 0 end

    for r = 0, 7 do
        local base = r * 16
        for f = 0, 7 do
            local s = base + f
            local p = B[s]
            if p > 0 then
                local n = CW[p] + 1
                CW[p] = n
                LW[p][n] = s
                if p == PAWN then
                    local fi = f + 2
                    fileW[fi] = fileW[fi] + 1
                    if r < minRW[fi] then minRW[fi] = r end
                    pAtkW[s + 15] = stamp; pAtkW[s + 17] = stamp
                end
            elseif p < 0 then
                local t = -p
                local n = CB[t] + 1
                CB[t] = n
                LB[t][n] = s
                if t == PAWN then
                    local fi = f + 2
                    fileB[fi] = fileB[fi] + 1
                    if r > maxRB[fi] then maxRB[fi] = r end
                    pAtkB[s - 15] = stamp; pAtkB[s - 17] = stamp
                end
            end
        end
    end

    local npmW, npmB = E.npmW, E.npmB
    if CW[1] + CB[1] == 0 and npmW <= 340 and npmB <= 340 then return 0 end

    local wk, bk = E.kingW, E.kingB
    zoneW[wk] = stamp
    zoneB[bk] = stamp
    for i = 1, 8 do
        zoneW[wk + KING_D[i]] = stamp
        zoneB[bk + KING_D[i]] = stamp
    end
    for d = -1, 1 do
        zoneW[wk + 32 + d] = stamp
        zoneB[bk - 32 + d] = stamp
    end

    local st = IDENTITY
    local wmg, weg, waw, wan = evalSide(E, B, WHITE, LW, CW, fileW, maxRB, pAtkB, zoneB, stamp, wk, bk, st)
    local bmg, beg, baw, ban = evalSide(E, B, BLACK, LB, CB, fileB, minRW, pAtkW, zoneW, stamp, bk, wk, st)

    local mg = E.mg + wmg - bmg
    local eg = E.eg + weg - beg

    local wkFlight = kingFlightSquares(E, wk, WHITE)
    local bkFlight = kingFlightSquares(E, bk, BLACK)

    local att = st.Att
    local dW = dangerOf(baw, ban, CB[5], att, wkFlight) -- black attacking white king
    local dB = dangerOf(waw, wan, CW[5], att, bkFlight) -- white attacking black king
    mg = mg - dW + dB
    eg = eg - dW * 0.25 + dB * 0.25
    mg = mg + (dB - dW) * 0.10   -- small tie-break: don't simplify away a live attack

    mg = mg + hangingTerm(E)

    local ph = E.phase
    if ph > 24 then ph = 24 end
    local score = floor((mg * ph + eg * (24 - ph)) / 24)
    score = score + E.side * TEMPO

    -- mop-up: drive a bare king to the edge and in close
    if npmW - npmB >= 450 and npmB == 0 and CB[1] == 0 then
        local f, r = band(bk, 15), rshift(bk, 4)
        local cd = mmax(3 - f, f - 4) + mmax(3 - r, r - 4)
        score = score + cd * 10 + (14 - kdist(wk, bk)) * 4
    elseif npmB - npmW >= 450 and npmW == 0 and CW[1] == 0 then
        local f, r = band(wk, 15), rshift(wk, 4)
        local cd = mmax(3 - f, f - 4) + mmax(3 - r, r - 4)
        score = score - (cd * 10 + (14 - kdist(wk, bk)) * 4)
    elseif score > 0 and CW[1] == 0 and npmW - npmB <= 350 then
        score = floor(score / 2)
    elseif score < 0 and CB[1] == 0 and npmB - npmW <= 350 then
        score = -floor(-score / 2)
    end
    return E.side * score
end

local function staticEval(E, alpha, beta)
    local ph = E.phase
    if ph > 24 then ph = 24 end
    local quick = E.side * floor((E.mg * ph + E.eg * (24 - ph)) / 24)
    if quick + LAZY <= alpha or quick - LAZY >= beta then return quick end
    return evaluate(E)
end

------------------------------------------------------------------------------
-- Transposition table (parallel arrays, replace-by-depth-with-age)
------------------------------------------------------------------------------
local function newTT(bits)
    local size = bit.lshift(1, bits)
    return {
        k1 = table.create(size, -1), k2 = table.create(size, -1),
        mv = table.create(size, 0), dp = table.create(size, 0),
        bd = table.create(size, 0), sc = table.create(size, 0),
        gn = table.create(size, 0),
        mask = size - 1, bits = bits,
    }
end
G.TT = G.TT and G.TT.k1 and G.TT or newTT(G.HashBits or 17)

local function ttStore(E, depth, score, bound, move, ply)
    local tt = E.tt
    local idx = band(E.h1, tt.mask) + 1
    local same = tt.k1[idx] == E.h1 and tt.k2[idx] == E.h2
    local old = tt.dp[idx]
    local replace
    if same then
        replace = depth >= old - 2 or bound == 0
    else
        replace = tt.gn[idx] ~= G.SearchId or depth >= old
    end
    if replace then
        if score > MATE - 1000 then score = score + ply
        elseif score < -MATE + 1000 then score = score - ply end
        if move == 0 and same then move = tt.mv[idx] end
        tt.k1[idx], tt.k2[idx] = E.h1, E.h2
        tt.mv[idx], tt.dp[idx], tt.bd[idx], tt.sc[idx], tt.gn[idx] = move, depth, bound, score, G.SearchId
    elseif same and move ~= 0 and tt.mv[idx] == 0 then
        tt.mv[idx] = move
    end
end

------------------------------------------------------------------------------
-- Search helpers: time slicing, draw/repetition scoring, history heuristic
------------------------------------------------------------------------------
local LMRT = {}
for d = 1, 64 do
    LMRT[d] = {}
    for i = 1, 64 do
        LMRT[d][i] = floor(0.7 + mlog(d) * mlog(i) / 2.2)
    end
end

local function touch(E)
    if E.abort then return false end
    local n = E.nodes + 1
    E.nodes = n
    if n >= E.nodeLimit then E.abort = true; return false end
    if band(n, 255) == 0 then
        local now = clock()
        if now >= E.deadline then E.abort = true; return false end
        if E.cancel and E.cancel() then E.abort = true; return false end
        if now - E.lastYield >= E.slice then
            yield()
            E.lastYield = clock()
        end
    end
    return true
end

local function drawScore(E, ply)
    local c = IDENTITY.Contempt
    if ply % 2 == 0 then return -c end
    return c
end

local function isRepetition(E)
    local n = E.repN
    local lim = E.half
    if lim > n - 1 then lim = n - 1 end
    local stop = n - lim
    local h1, h2 = E.h1, E.h2
    local r1, r2 = E.rep1, E.rep2
    local i = n - 2
    while i >= stop and i >= 1 do
        if r1[i] == h1 and r2[i] == h2 then return true end
        i = i - 2
    end
    return false
end

local function addHist(E, k, b)
    local h = E.history[k] or 0
    E.history[k] = h + b - floor(h * abs(b) / 16384)
end

local function pick(moves, scores, i, n)
    local best, bs = i, scores[i]
    for j = i + 1, n do
        if scores[j] > bs then best = j; bs = scores[j] end
    end
    if best ~= i then
        moves[i], moves[best] = moves[best], moves[i]
        scores[i], scores[best] = scores[best], scores[i]
    end
end

------------------------------------------------------------------------------
-- SACRIFICE COMPENSATION
--
-- Cheap, pre-move heuristics that flag "this looks like it could be a real
-- sacrifice, not just a blunder" so the move survives SEE-based pruning and
-- gets a fair look from full-width search -- which is what actually proves
-- or disproves it. This function never *accepts* a sacrifice by itself; it
-- only decides what gets searched more carefully.
------------------------------------------------------------------------------
local function opensLineToKing(E, side, from)
    local B = E.board
    local enemyK = (side == WHITE) and E.kingB or E.kingW
    local dr = rshift(from, 4) - rshift(enemyK, 4)
    local df = band(from, 15) - band(enemyK, 15)
    if dr == 0 and df == 0 then return false end
    local dir, isDiag
    if dr == 0 then dir = (df > 0) and 1 or -1; isDiag = false
    elseif df == 0 then dir = (dr > 0) and 16 or -16; isDiag = false
    elseif abs(dr) == abs(df) then
        dir = ((dr > 0) and 16 or -16) + ((df > 0) and 1 or -1); isDiag = true
    else
        return false
    end
    local t = enemyK + dir
    local passedFrom = false
    while ON[t + 64] do
        if t == from then
            passedFrom = true
        else
            local q = B[t]
            if q ~= 0 then
                if passedFrom and q * side > 0 then
                    local pt = abs(q)
                    if pt == QUEEN or (isDiag and pt == BISHOP) or ((not isDiag) and pt == ROOK) then
                        return true
                    end
                end
                return false
            end
        end
        t = t + dir
    end
    return false
end

local function sacAttraction(E, m)
    local side = E.side
    local from, to = band(m, 127), band(rshift(m, 7), 127)
    local enemyK = (side == WHITE) and E.kingB or E.kingW
    local score = 0
    local dk = kdist(to, enemyK)
    if dk <= 1 then score = score + 48
    elseif dk == 2 then score = score + 16 end
    if opensLineToKing(E, side, from) then score = score + 55 end
    return score
end

------------------------------------------------------------------------------
-- Move ordering. Tiers (highest first): TT move > winning/equal capture >
-- promotions > SPECULATIVE SACRIFICE (material-losing but king-zone/line-
-- opening, per sacAttraction) > killers > countermove > history, with a
-- king-proximity nudge on quiet moves and plain losing captures sinking to
-- the bottom where they belong.
------------------------------------------------------------------------------
local function moveScore(E, m, ply, ttMove)
    if m == ttMove and m ~= 0 then return 9000000 end
    local B = E.board
    local from, to = band(m, 127), band(rshift(m, 7), 127)
    local flags, promo = band(rshift(m, 17), 15), band(rshift(m, 14), 7)
    local piece = B[from]
    local pt = piece > 0 and piece or -piece
    if band(flags, FLAG_CAPTURE) ~= 0 then
        local victim = (band(flags, FLAG_EP) ~= 0) and PAWN or abs(B[to])
        local vv, av = VAL[victim], VAL[pt]
        local mvv = vv * 10 - pt
        local score
        if vv >= av then
            score = 2000000 + mvv
        else
            local s = see(E, m)
            if s >= 0 then
                score = 2000000 + mvv
            else
                local attraction = sacAttraction(E, m)
                if attraction >= 40 then
                    score = 500000 + attraction * 100 + s
                else
                    score = -1000000 + s
                end
            end
        end
        if promo == QUEEN then score = score + 800 end
        return score
    end
    if promo ~= 0 then
        return promo == QUEEN and 1950000 or -900000
    end
    local k = E.killers[ply]
    if k then
        if m == k[1] then return 900000 end
        if m == k[2] then return 800000 end
    end
    if ply > 0 then
        local prev = E.stack[ply - 1]
        if prev and prev.piece ~= 0 and E.counter[(prev.piece + 7) * 128 + prev.to] == m then
            return 700000
        end
    end
    local score = E.history[(piece + 7) * 128 + to] or 0
    local fl = band(to, 15)
    if fl == 3 or fl == 4 then score = score + IDENTITY.Center end
    local enemyK = (E.side == WHITE) and E.kingB or E.kingW
    local dk = kdist(to, enemyK)
    if dk <= 2 then score = score + (3 - dk) * 14 end
    return score
end

------------------------------------------------------------------------------
-- Quiescence search. Captures/promotions/check-evasions only, with SEE-based
-- pruning of hopeless captures -- except a capture that lands right next to
-- the enemy king is exempted, because that is exactly the kind of "it looks
-- like it loses material but look what it threatens" line the engine is
-- built to find.
------------------------------------------------------------------------------
local function qsearch(E, alpha, beta, ply, qd)
    if not touch(E) then return 0 end
    E.qnodes = E.qnodes + 1
    if ply >= MAX_PLY - 1 then return evaluate(E) end
    if E.half >= 100 then return 0 end
    local checked = inCheck(E, E.side)
    local stand, best
    if checked then
        if qd > E.maxQDepth + 6 then return evaluate(E) end
        best = -INF
    else
        stand = staticEval(E, alpha, beta)
        if stand >= beta then return stand end
        if stand > alpha then alpha = stand end
        if qd >= E.maxQDepth then return stand end
        best = stand
    end

    local moves = generate(E, not checked)
    local n = #moves
    local scores = {}
    local B = E.board
    for i = 1, n do
        local m = moves[i]
        local flags = band(rshift(m, 17), 15)
        local sc = 0
        if band(flags, FLAG_CAPTURE) ~= 0 then
            local victim = (band(flags, FLAG_EP) ~= 0) and PAWN or abs(B[band(rshift(m, 7), 127)])
            local pt = abs(B[band(m, 127)])
            sc = 1000000 + VAL[victim] * 10 - pt
        elseif band(rshift(m, 14), 7) ~= 0 then
            sc = 900000
        end
        scores[i] = sc
    end

    local enemyK = (E.side == WHITE) and E.kingB or E.kingW
    local legal = 0
    for i = 1, n do
        pick(moves, scores, i, n)
        local m = moves[i]
        local flags, promo = band(rshift(m, 17), 15), band(rshift(m, 14), 7)
        local skip = false
        if not checked then
            if band(flags, FLAG_CAPTURE) ~= 0 then
                local victim = (band(flags, FLAG_EP) ~= 0) and PAWN or abs(B[band(rshift(m, 7), 127)])
                if promo == 0 and stand + VAL[victim] + 200 < alpha then
                    skip = true
                elseif VAL[victim] < VAL[abs(B[band(m, 127)])] and see(E, m) < 0 then
                    if kdist(band(rshift(m, 7), 127), enemyK) > 1 then
                        skip = true
                    end
                end
            end
        end
        if not skip and makeMove(E, m, ply) then
            legal = legal + 1
            local score = -qsearch(E, -beta, -alpha, ply + 1, qd + 1)
            unmakeMove(E, m, ply)
            if E.abort then return 0 end
            if score > best then
                best = score
                if score > alpha then
                    alpha = score
                    if score >= beta then return score end
                end
            end
        end
    end
    if checked and legal == 0 then return -MATE + ply end
    return best
end

------------------------------------------------------------------------------
-- Main search: iterative-deepening driver below calls into this. PVS with
-- null-move pruning, razoring, reverse futility, LMR, internal iterative
-- deepening, and the two Bunny's Gambit additions: a one-ply extension for
-- bounded-loss captures that head at the enemy king (verified rather than
-- trusted), and a widened move budget for the first couple of plies so the
-- engine looks at substantially more candidate replies right where it's
-- actually making its decision.
------------------------------------------------------------------------------
local SAC_TIER_LOW, SAC_TIER_HIGH = 490000, 700000

local function negamax(E, depth, alpha, beta, ply, allowNull)
    if not touch(E) then return 0 end
    local isPV = beta - alpha > 1

    if ply > 0 then
        if E.half >= 100 then return drawScore(E, ply) end
        if isRepetition(E) then return drawScore(E, ply) end
        local a2 = mmax(alpha, -MATE + ply)
        local b2 = mmin(beta, MATE - ply - 1)
        if a2 >= b2 then return a2 end
        alpha, beta = a2, b2
    end
    if ply >= MAX_PLY - 1 then return evaluate(E) end

    local checked = inCheck(E, E.side)
    if depth <= 0 then return qsearch(E, alpha, beta, ply, 0) end
    if checked then depth = depth + 1 end

    local alpha0 = alpha
    local nearRoot = ply <= 2    -- the ~25-reply widened zone

    -- TT probe
    local tt = E.tt
    local idx = band(E.h1, tt.mask) + 1
    local ttMove, ttScore, ttDepth, ttBound = 0, 0, -1, 0
    if tt.k1[idx] == E.h1 and tt.k2[idx] == E.h2 then
        ttMove, ttDepth, ttBound, ttScore = tt.mv[idx], tt.dp[idx], tt.bd[idx], tt.sc[idx]
        if ttScore > MATE - 1000 then ttScore = ttScore - ply
        elseif ttScore < -MATE + 1000 then ttScore = ttScore + ply end
        if not isPV and ttDepth >= depth then
            if ttBound == 0 or (ttBound == 2 and ttScore >= beta) or (ttBound == 1 and ttScore <= alpha) then
                return ttScore
            end
        end
    end

    local static = -INF
    if not checked then static = staticEval(E, alpha, beta) end
    E.evalStack[ply] = static
    local improving = false
    if not checked and ply >= 2 then
        local e2 = E.evalStack[ply - 2]
        improving = e2 ~= nil and e2 > -INF and static > e2
    end

    local side = E.side
    if not isPV and not checked and abs(beta) < MATE - 1000 then
        if depth <= 6 and static - 85 * depth + (improving and 0 or 25) >= beta then
            return static
        end
        if depth <= 2 and static + 250 * depth <= alpha then
            local q = qsearch(E, alpha, beta, ply, 0)
            if E.abort then return 0 end
            if q <= alpha then return q end
        end
        local npm = (side == WHITE) and E.npmW or E.npmB
        if allowNull and depth >= 3 and static >= beta and npm > 0 then
            local R = 3 + floor(depth / 4) + mmin(2, floor((static - beta) / 200))
            local oldEp, oh1, oh2, ohalf = E.ep, E.h1, E.h2, E.half
            local sN = E.stack[ply]
            if not sN then sN = {}; E.stack[ply] = sN end
            sN.piece, sN.to = 0, 0
            if oldEp >= 0 then
                local fi = band(oldEp, 15) + 1
                E.h1 = bxor(E.h1, ZE1[fi]); E.h2 = bxor(E.h2, ZE2[fi])
            end
            E.ep = -1
            E.h1 = bxor(E.h1, ZS1); E.h2 = bxor(E.h2, ZS2)
            E.side = -side
            E.half = 0
            local nr = E.repN + 1
            E.repN = nr
            E.rep1[nr], E.rep2[nr] = E.h1, E.h2
            local score = -negamax(E, depth - 1 - R, -beta, -beta + 1, ply + 1, false)
            E.repN = nr - 1
            E.side = side
            E.ep = oldEp
            E.h1, E.h2, E.half = oh1, oh2, ohalf
            if E.abort then return 0 end
            if score >= beta then
                if score > MATE - 1000 then score = beta end
                if depth < 9 then return score end
                local v = negamax(E, depth - R, beta - 1, beta, ply, false)
                if E.abort then return 0 end
                if v >= beta then return score end
            end
        end
    end

    if isPV and ttMove == 0 and depth >= 5 then
        negamax(E, depth - 2, alpha, beta, ply, false)
        if E.abort then return 0 end
        if tt.k1[idx] == E.h1 and tt.k2[idx] == E.h2 then ttMove = tt.mv[idx] end
    end

    local moves = generate(E, false)
    local n = #moves
    local scores = {}
    for i = 1, n do scores[i] = moveScore(E, moves[i], ply, ttMove) end

    local best, bestMove, legal = -INF, 0, 0
    local quiets, nq = {}, 0
    local B = E.board
    local lmpBase = nearRoot and 26 or 3

    for i = 1, n do
        pick(moves, scores, i, n)
        local m, sc = moves[i], scores[i]
        local flags, promo = band(rshift(m, 17), 15), band(rshift(m, 14), 7)
        local isCap = band(flags, FLAG_CAPTURE) ~= 0
        local quiet = (not isCap) and promo == 0
        local isSacTier = sc >= SAC_TIER_LOW and sc < SAC_TIER_HIGH

        local prune = false
        if not isPV and not checked and best > -MATE + 1000 then
            if quiet then
                if depth <= 3 and nq >= lmpBase + depth * depth then prune = true end
            elseif isCap and not isSacTier and sc < -500000 and depth <= 5 and (sc + 1000000) < -90 * depth then
                prune = true
            end
        end

        if not prune and makeMove(E, m, ply) then
            legal = legal + 1
            local skip = false
            if quiet and not isPV and not checked and not nearRoot and depth <= 4 and legal > 1
                and best > -MATE + 1000 and static + 90 + 110 * depth <= alpha then
                if not inCheck(E, E.side) then skip = true end
            end
            if skip then
                unmakeMove(E, m, ply)
            else
                local newDepth = depth - 1
                if isSacTier and newDepth < MAX_PLY - 8 then
                    -- speculative sacrifice aimed at the king: verify it for real
                    -- instead of trusting the heuristic that flagged it
                    newDepth = newDepth + 1
                end
                local score
                if legal == 1 then
                    score = -negamax(E, newDepth, -beta, -alpha, ply + 1, true)
                else
                    local r = 0
                    if depth >= 3 and not checked then
                        if quiet then
                            r = LMRT[mmin(depth, 64)][mmin(legal, 64)]
                            r = floor(r * IDENTITY.LMR + 0.5)
                            if isPV then r = r - 1 end
                            if not improving then r = r + 1 end
                            if sc >= 700000 then r = r - 1
                            elseif sc > -20000 and sc < 20000 then r = r - floor(sc / 5000) end
                        elseif isCap and sc < -500000 and not isSacTier then
                            r = 1
                        end
                        if r < 0 then r = 0 end
                        if r > newDepth - 1 then r = mmax(0, newDepth - 1) end
                    end
                    score = -negamax(E, newDepth - r, -alpha - 1, -alpha, ply + 1, true)
                    if score > alpha and r > 0 then
                        score = -negamax(E, newDepth, -alpha - 1, -alpha, ply + 1, true)
                    end
                    if score > alpha and score < beta then
                        score = -negamax(E, newDepth, -beta, -alpha, ply + 1, true)
                    end
                end
                unmakeMove(E, m, ply)
                if E.abort then return 0 end

                if score > best then
                    best = score
                    bestMove = m
                    if score > alpha then
                        alpha = score
                        if alpha >= beta then
                            if quiet then
                                local k = E.killers[ply]
                                if not k then k = {0, 0}; E.killers[ply] = k end
                                if k[1] ~= m then k[2] = k[1]; k[1] = m end
                                local bonus = mmin(2000, depth * depth * 32)
                                local pk = (B[band(m, 127)] + 7) * 128 + band(rshift(m, 7), 127)
                                addHist(E, pk, bonus)
                                for q = 1, nq do
                                    local qm = quiets[q]
                                    addHist(E, (B[band(qm, 127)] + 7) * 128 + band(rshift(qm, 7), 127), -bonus)
                                end
                                if ply > 0 then
                                    local prev = E.stack[ply - 1]
                                    if prev and prev.piece ~= 0 then
                                        E.counter[(prev.piece + 7) * 128 + prev.to] = m
                                    end
                                end
                            end
                            break
                        end
                    end
                end
                if quiet then nq = nq + 1; quiets[nq] = m end
            end
        end
    end

    if legal == 0 then
        if checked then return -MATE + ply end
        return 0
    end

    local bound = (best >= beta) and 2 or ((best > alpha0) and 0 or 1)
    ttStore(E, depth, best, bound, bestMove, ply)
    return best
end

local function rootSearch(E, depth, alpha, beta)
    local list = E.root
    local best, bestMove = -INF, 0
    local quietRoot = not inCheck(E, E.side)
    for i = 1, #list do
        local ent = list[i]
        local m = ent.m
        if makeMove(E, m, 0) then
            local newDepth = depth - 1
            local score
            if i == 1 then
                score = -negamax(E, newDepth, -beta, -alpha, 1, true)
            else
                local r = 0
                if depth >= 3 and i >= 4 and quietRoot and band(rshift(m, 17), 15) == 0 and band(rshift(m, 14), 7) == 0 then
                    r = (i > 10) and 2 or 1
                    if r > newDepth - 1 then r = mmax(0, newDepth - 1) end
                end
                score = -negamax(E, newDepth - r, -alpha - 1, -alpha, 1, true)
                if score > alpha and r > 0 then
                    score = -negamax(E, newDepth, -alpha - 1, -alpha, 1, true)
                end
                if score > alpha and score < beta then
                    score = -negamax(E, newDepth, -beta, -alpha, 1, true)
                end
            end
            unmakeMove(E, m, 0)
            if E.abort then return bestMove, best, false end
            ent.score = score
            if score > best then best = score; bestMove = m end
            if score > alpha then alpha = score end
            if alpha >= beta then break end
        end
    end
    return bestMove, best, true
end

------------------------------------------------------------------------------
-- FEN parsing
------------------------------------------------------------------------------
local FENP = {P = 1, N = 2, B = 3, R = 4, Q = 5, K = 6, p = -1, n = -2, b = -3, r = -4, q = -5, k = -6}

local function parseFEN(fen)
    local fields = {}
    for part in string.gmatch(fen, "%S+") do fields[#fields + 1] = part end
    local placement = fields[1] or "8/8/8/8/8/8/8/8"
    local side = (fields[2] == "b") and BLACK or WHITE
    local castleText = fields[3] or "-"
    local epText = fields[4] or "-"
    local half = tonumber(fields[5] or "0") or 0

    local B = {}
    for i = 0, 127 do B[i] = 0 end
    local kingW, kingB = -1, -1
    local mg, eg, phase, npmW, npmB = 0, 0, 0, 0, 0
    local rank = 7
    for row in string.gmatch(placement, "[^/]+") do
        local file = 0
        for ch in string.gmatch(row, ".") do
            local num = tonumber(ch)
            if num then
                file = file + num
            else
                local piece = FENP[ch]
                if piece and file < 8 and rank >= 0 then
                    local s = rank * 16 + file
                    B[s] = piece
                    mg = mg + MGT[piece + 7][s]
                    eg = eg + EGT[piece + 7][s]
                    local pt = piece > 0 and piece or -piece
                    phase = phase + PHASE_W[pt]
                    if pt ~= PAWN and pt ~= KING then
                        if piece > 0 then npmW = npmW + VAL[pt] else npmB = npmB + VAL[pt] end
                    end
                    if piece == KING then kingW = s end
                    if piece == -KING then kingB = s end
                    file = file + 1
                end
            end
        end
        rank = rank - 1
    end

    local castle = 0
    if string.find(castleText, "K", 1, true) then castle = castle + 1 end
    if string.find(castleText, "Q", 1, true) then castle = castle + 2 end
    if string.find(castleText, "k", 1, true) then castle = castle + 4 end
    if string.find(castleText, "q", 1, true) then castle = castle + 8 end
    local ep = -1
    if epText ~= "-" and #epText >= 2 then
        local f = string.byte(epText, 1) - 97
        local r = tonumber(epText:sub(2, 2))
        if f >= 0 and f < 8 and r and r >= 1 and r <= 8 then ep = (r - 1) * 16 + f end
    end

    local E = {
        board = B, side = side, castle = castle, ep = ep, half = half,
        mg = mg, eg = eg, phase = phase, npmW = npmW, npmB = npmB,
        kingW = kingW, kingB = kingB, h1 = 0, h2 = 0,
        stack = {}, tt = G.TT, killers = {}, history = {}, counter = {}, evalStack = {},
        nodes = 0, qnodes = 0, abort = false, maxQDepth = 8, deadline = math.huge,
        nodeLimit = 50000000, lastYield = clock(), slice = 0.03, cancel = nil,
        root = {},
    }
    local h1, h2 = 0, 0
    for i = 0, 127 do
        local p = B[i]
        if p ~= 0 then
            h1 = bxor(h1, ZP1[p + 7][i + 1]); h2 = bxor(h2, ZP2[p + 7][i + 1])
        end
    end
    h1 = bxor(h1, ZC1[castle + 1]); h2 = bxor(h2, ZC2[castle + 1])
    if ep >= 0 then
        local fi = band(ep, 15) + 1
        h1 = bxor(h1, ZE1[fi]); h2 = bxor(h2, ZE2[fi])
    end
    if side == BLACK then h1 = bxor(h1, ZS1); h2 = bxor(h2, ZS2) end
    E.h1, E.h2 = h1, h2
    E.rep1, E.rep2, E.repN = {h1}, {h2}, 1
    return E
end

------------------------------------------------------------------------------
-- Opening book: sharp, well-known gambit and attacking lines only. This is
-- Bunny's Gambit, not a drawing-master's repertoire -- the book exists to
-- reach a position the engine's own tactical eye is happy to fight from,
-- not to bank a theoretical draw.
------------------------------------------------------------------------------
local BOOK_LINES = {
    -- King's Gambit
    "e2e4 e7e5 f2f4 e5f4 g1f3 g7g5 h2h4 g5g4 f3e5 d7d6 e5g4",
    "e2e4 e7e5 f2f4 e5f4 f1c4 d8h4 e1f1 b7b5 c4b5 g8f6",
    -- Evans Gambit
    "e2e4 e7e5 g1f3 b8c6 f1c4 f8c5 b2b4 c5b4 c2c3 b4a5 d2d4 g8f6",
    -- Danish / Scotch Gambit
    "e2e4 e7e5 g1f3 b8c6 d2d4 e5d4 f1c4 f8c5 c2c3 d4c3",
    -- Smith-Morra Gambit
    "e2e4 c7c5 d2d4 c5d4 c2c3 d4c3 b1c3 b8c6 g1f3 d7d6",
    -- Wing Gambit / open Sicilian aggression
    "e2e4 c7c5 g1f3 d7d6 d2d4 c5d4 f3d4 g8f6 b1c3 a7a6 c1g5 e7e6 f2f4",
    -- Blackmar-Diemer Gambit
    "d2d4 d7d5 e2e4 d5e4 b1c3 g8f6 f2f3 e4f3 g1f3",
    -- Queen's Gambit, sharp lines
    "d2d4 d7d5 c2c4 e7e6 b1c3 g8f6 c1g5 f8e7 e2e3 e8g8 g1f3 h7h6 g5h4",
    -- King's Indian Attack / Saemisch-style aggression
    "d2d4 g8f6 c2c4 g7g6 b1c3 f8g7 e2e4 d7d6 f2f3 e8g8 c1e3 e7e5 d4d5 f6h5",
    -- Vienna Gambit
    "e2e4 e7e5 b1c3 g8f6 f2f4 d7d5 f4e5 f6e4",
    -- Italian, aggressive Fried Liver-adjacent
    "e2e4 e7e5 g1f3 b8c6 f1c4 g8f6 f3g5 d7d5 e4d5 f6d5 g5f7",
}

local function buildBook()
    local book = {}
    for _, line in ipairs(BOOK_LINES) do
        local pos = parseFEN(START_FEN)
        local ply = 0
        for token in string.gmatch(line, "%S+") do
            local moves = generate(pos, false)
            local found
            for j = 1, #moves do
                if moveAlgebraic(moves[j]) == token then found = moves[j]; break end
            end
            if not found then break end
            local key = tostring(pos.h1) .. ":" .. tostring(pos.h2)
            local entry = book[key]
            if not entry then entry = {}; book[key] = entry end
            entry[token] = (entry[token] or 0) + 1
            if not makeMove(pos, found, ply) then break end
            ply = ply + 1
        end
    end
    return book
end

